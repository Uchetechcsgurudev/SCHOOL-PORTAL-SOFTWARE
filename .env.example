SCHOOL_PORT=3030
SCHOOL_HOST=127.0.0.1
NODE_ENV=development
# Required when exposing the app beyond localhost or running in production.
# Generate a private random value of at least 32 characters for first-admin setup.
SCHOOL_SETUP_KEY=
# Optional: keep the private SQLite school database outside this project.
# The default is ../.school-portal-private/
SCHOOL_DATABASE_DIR=
